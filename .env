# Development Environment Variables for EduPortal

# ============================================
# DATABASE SETUP - SQLite (File-based, No Setup Required!)
# ============================================
DATABASE_URL=file:./edu-portal.db

# Option 2: Local MySQL
# DATABASE_URL=mysql://root:password@localhost:3306/edu-portal

# ============================================
# API Configuration
# ============================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_OAUTH_PORTAL_URL=http://localhost:3000
EXPO_PUBLIC_OAUTH_SERVER_URL=http://localhost:3000
EXPO_PUBLIC_APP_ID=edu-portal-dev
EXPO_PUBLIC_OWNER_OPEN_ID=owner-demo
EXPO_PUBLIC_OWNER_NAME="EduPortal"

# ============================================
# JWT Secret (for backend)
# ============================================
JWT_SECRET=dev-jwt-secret-change-in-production

# ============================================
# Node Environment
# ============================================
NODE_ENV=development
EXPO_PORT=8081

# ============================================
# Expo Configuration
# ============================================
EXPO_PORT=8081
